{
  "name": "quran-app-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run dev:android",
    "dev:android": "node scripts/dev-android.js",
    "start:perf": "npm run perf:android",
    "perf:android": "node scripts/start-android-emulator.js && expo run:android --variant release --no-bundler",
    "perf:android:clean": "node scripts/start-android-emulator.js && expo run:android --variant release --no-bundler --no-build-cache",
    "device:android": "node scripts/android-physical-device.js info",
    "android:device": "node scripts/android-physical-device.js install-debug",
    "dev:android:device": "node scripts/android-physical-device.js dev",
    "perf:android:device": "node scripts/android-physical-device.js install-release",
    "perf:android:baseline-profile": "python3 scripts/perf/android-baseline-profile.py",
    "metro": "node scripts/prepare-expo-start.js && expo start",
    "emulator": "node scripts/start-android-emulator.js",
    "setup:emulator:budget": "node scripts/setup-android-budget-avd.js",
    "emulator:budget": "node scripts/setup-android-budget-avd.js && node scripts/start-android-emulator.js quran_budget_api34",
    "android": "expo run:android",
    "perf:android:budget": "node scripts/setup-android-budget-avd.js && node scripts/start-android-emulator.js quran_budget_api34 && expo run:android --variant release --no-bundler --device quran_budget_api34",
    "build:android:apk": "cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64",
    "build:android:bundle": "cd android && ./gradlew :app:bundleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64",
    "build:android:release": "cd android && ./gradlew :app:assembleRelease :app:bundleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64",
    "ios": "expo run:ios",
    "perf:ios": "expo run:ios --configuration Release --no-bundler",
    "web": "expo start --web",
    "postinstall": "node scripts/postinstall.js",
    "sync:web-core": "node scripts/sync-web-core.js",
    "generate:translation-packs": "node scripts/generate-translation-packs.js",
    "generate:verse-spotlight": "node scripts/verse-spotlight/generate-assets.cjs",
    "generate:word-translation-packs": "node scripts/generate-word-translation-packs.js",
    "generate:tafsir-packs": "node scripts/generate-tafsir-packs.js",
    "generate:mushaf-packs": "node scripts/generate-mushaf-packs.js",
    "audit:download-packs": "node scripts/audit-download-packs.js",
    "normalize:download-pack-urls": "node scripts/normalize-download-pack-urls.js",
    "upload:download-packs": "node scripts/upload-download-packs.js",
    "compile:word-study-pack": "node scripts/compile-word-study-pack.cjs",
    "compile:word-grammar-pack": "node scripts/compile-word-grammar-pack.cjs",
    "compile:word-reference-packs": "node scripts/compile-word-reference-packs.cjs",
    "compile:verb-reference-pack": "node scripts/compile-verb-reference-pack.cjs",
    "test:word-study-pack": "node --test tests/word-study-pack/*.test.cjs",
    "build:test-word-study-repository": "tsc -p tests/word-study-repository/tsconfig.json",
    "test:word-study-repository": "npm run build:test-word-study-repository && node --test tests/word-study-repository/*.test.cjs",
    "benchmark:word-study-repository": "npm run build:test-word-study-repository && node scripts/benchmark-word-study-repository.cjs",
    "build:test-word-study-quick-sheet": "tsc -p tests/word-study-quick-sheet/tsconfig.json",
    "test:word-study-quick-sheet": "npm run build:test-word-study-quick-sheet && node --test .artifacts/word-study-quick-sheet-tests/tests/word-study-quick-sheet/*.test.cjs",
    "build:test-word-study-screen": "tsc -p tests/word-study-screen/tsconfig.json",
    "test:word-study-screen": "npm run build:test-word-study-screen && node --test .artifacts/word-study-screen-tests/tests/word-study-screen/*.test.cjs",
    "test:welcome-resource-setup": "node --test tests/welcome-resource-setup/*.test.cjs",
    "build:test-download-concurrency": "tsc -p tests/download-concurrency/tsconfig.json",
    "test:download-concurrency": "npm run build:test-download-concurrency && node --test .artifacts/download-concurrency-tests/tests/download-concurrency/*.test.cjs",
    "build:test-search-numerals": "tsc -p tests/search-numerals/tsconfig.json",
    "test:search-numerals": "npm run build:test-search-numerals && node --test .artifacts/search-numeral-tests/tests/search-numerals/*.cjs",
    "build:test-offline-search": "tsc -p tests/offline-search/tsconfig.json",
    "test:offline-search": "npm run build:test-offline-search && node --test .artifacts/offline-search-tests/tests/offline-search/*.cjs",
    "build:test-verse-spotlight": "tsc -p tests/verse-spotlight/tsconfig.json",
    "test:verse-spotlight": "npm run build:test-verse-spotlight && node --test .artifacts/verse-spotlight-tests/tests/verse-spotlight/*.test.cjs",
    "test:verse-spotlight-widget-plugin": "node --test tests/verse-spotlight-widget/*.test.cjs",
    "test:verse-spotlight-widget-android": "node -e \"require('./plugins/withVerseSpotlightWidget').syncNativeFiles(process.cwd())\" && cd android && ./gradlew :app:testDebugUnitTest --tests 'com.anonymous.quranappmobile.versespotlight.*'",
    "debug:android": "node scripts/android-debug.js",
    "debug:android:devices": "node scripts/android-debug.js devices",
    "debug:android:logs": "node scripts/android-debug.js logs",
    "debug:android:screenshot": "node scripts/android-debug.js screenshot",
    "debug:android:ui": "node scripts/android-debug.js ui",
    "type-check": "tsc --noEmit",
    "test:verse": "node --test tests/verse/*.test.cjs",
    "check:core": "node scripts/check-core-purity.js",
    "verify": "npm run type-check && npm run check:core && npm run test:download-concurrency && npm run test:search-numerals && npm run test:offline-search && npm run test:verse && npm run test:verse-spotlight && npm run test:verse-spotlight-widget-plugin && npm run test:welcome-resource-setup && npm run test:word-study-pack && npm run test:word-study-repository && npm run test:word-study-quick-sheet && npm run test:word-study-screen && npm run test:tafsir-pager && npm run test:tafsir-packs && npm run test:bookmarks-layout && npm run test:modal-transition",
    "build:test-tafsir-pager": "tsc -p tests/tafsir-pager/tsconfig.json",
    "test:tafsir-pager": "npm run build:test-tafsir-pager && node --test .artifacts/tafsir-pager-tests/tests/tafsir-pager/*.cjs",
    "test:tafsir-packs": "node --test tests/tafsir-packs/*.test.cjs",
    "test:modal-transition": "node --test tests/modal-transition/*.test.cjs",
    "test:bookmarks-layout": "node --test tests/bookmarks/*.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@shopify/flash-list": "^2.3.2",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.17.0",
    "nativewind": "^4.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "private": true
}
