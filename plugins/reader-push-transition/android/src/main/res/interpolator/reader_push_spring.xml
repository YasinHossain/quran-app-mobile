<?xml version="1.0" encoding="utf-8"?>
<!--
  Cubic fit (max error < 1%) of the critically damped entrance spring in
  components/motion/modalTransition.ts, so a reader push moves like the settings drawer:
  most of the travel early, then a long, gentle settle.
-->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.225"
    android:controlY1="0.15"
    android:controlX2="0.175"
    android:controlY2="1" />
