<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_spotlight_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/verse_spotlight_serenity_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <ListView
        android:id="@+id/verse_spotlight_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/verse_spotlight_serenity_border"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <!-- Left Half: Reference metadata on far left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/verse_spotlight_metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:text="@string/verse_spotlight_preview_metadata"
                android:textColor="@color/verse_spotlight_serenity_accent"
                android:textDirection="firstStrong"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Vertical Separation Line in exact middle -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="@color/verse_spotlight_serenity_border"
            android:importantForAccessibility="no" />

        <!-- Right Half: Navigation controls on far right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/verse_spotlight_previous"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/verse_spotlight_serenity_control_background"
                android:contentDescription="@string/verse_spotlight_previous"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/verse_spotlight_ic_previous"
                android:tint="@color/verse_spotlight_serenity_text" />

            <ImageButton
                android:id="@+id/verse_spotlight_shuffle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/verse_spotlight_serenity_shuffle_background"
                android:contentDescription="@string/verse_spotlight_shuffle"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/verse_spotlight_ic_shuffle"
                android:tint="@color/verse_spotlight_serenity_on_accent" />

            <ImageButton
                android:id="@+id/verse_spotlight_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/verse_spotlight_serenity_control_background"
                android:contentDescription="@string/verse_spotlight_next"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/verse_spotlight_ic_next"
                android:tint="@color/verse_spotlight_serenity_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
